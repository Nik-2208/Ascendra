generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(uuid())
  name                 String?
  email                String                @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  googleId             String?               @unique
  appleId              String?               @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  conversations        AIConversation[]
  insights             AIInsight[]
  accounts             Account[]
  achievements         AchievementProgress[]
  analytics            AnalyticsEvent[]
  bossProgress         BossProgress?
  character            Character?
  chronicles           Chronicle[]
  focusSessions        FocusSession[]
  inventory            Inventory?
  moneyJar             MoneyJar?
  notifications        Notification[]
  personalBudgets      PersonalBudget[]
  personalCategories   PersonalCategory[]
  personalTransactions PersonalTransaction[]
  pets                 Pet[]
  profile              Profile?
  purchases            Purchase[]
  quests               QuestProgress[]
  schedules            Schedule[]
  seasonPasses         SeasonPass[]
  sessions             Session[]
  shopState            ShopState?
  masteries            SkillMastery[]
  streaks              Streak[]
  tasks                Task[]
  transactions         Transaction[]
  settings             UserSettings?
  wallets              Wallet[]
  worldRegions         WorldRegion[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  username  String   @unique
  bio       String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id           String   @id @default(uuid())
  userId       String   @unique
  theme        String   @default("dark")
  soundEnabled Boolean  @default(true)
  pushEnabled  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Character {
  id            String          @id @default(uuid())
  userId        String          @unique
  name          String
  class         String          @default("Novice")
  level         Int             @default(1)
  xp            Int             @default(0)
  prestige      Int             @default(0)
  villageLevel  Int             @default(1)
  villageHealth Int             @default(100)
  rebirths      Int             @default(0)
  buildings     Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stats         CharacterStats?
  skills        Skill[]
}

model CharacterStats {
  id           String    @id @default(uuid())
  characterId  String    @unique
  hp           Int       @default(100)
  maxHp        Int       @default(100)
  strength     Int       @default(10)
  defense      Int       @default(10)
  intelligence Int       @default(10)
  agility      Int       @default(10)
  luck         Int       @default(10)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model SkillTreeNode {
  id            String          @id @default(uuid())
  name          String
  description   String
  requiredLevel Int             @default(1)
  cost          Int             @default(1)
  parentId      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  skills        Skill[]
  parent        SkillTreeNode?  @relation("SkillTreeEdges", fields: [parentId], references: [id])
  children      SkillTreeNode[] @relation("SkillTreeEdges")
}

model Skill {
  id          String        @id @default(uuid())
  characterId String
  skillNodeId String
  level       Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skillNode   SkillTreeNode @relation(fields: [skillNodeId], references: [id])

  @@unique([characterId, skillNodeId])
}

model Quest {
  id          String          @id @default(uuid())
  title       String
  description String
  type        QuestType
  xpReward    Int
  coinReward  Int
  isGlobal    Boolean         @default(false)
  creatorId   String?
  taskId      String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  progress    QuestProgress[]
}

model QuestProgress {
  id          String      @id @default(uuid())
  userId      String
  questId     String
  status      QuestStatus @default(ACTIVE)
  progress    Int         @default(0)
  target      Int         @default(1)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  quest       Quest       @relation(fields: [questId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Boss {
  id          String       @id @default(uuid())
  name        String
  description String
  hp          Int
  maxHp       Int
  damage      Int
  defense     Int
  levelReq    Int          @default(1)
  imageUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
}

model BossProgress {
  id                 String   @id @default(uuid())
  userId             String   @unique
  dedicatedBossId    String?
  currentBossId      String?
  currentRegionId    String?
  bossHP             Int      @default(0)
  maxHP              Int      @default(0)
  activeEasyTask     String?
  activeMediumTask   String?
  activeHardTask     String?
  completedTaskIds   String[]
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Item {
  id             String          @id @default(uuid())
  name           String
  description    String
  type           ItemType
  rarity         String          @default("Common")
  value          Int             @default(0)
  imageUrl       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  consumable     Consumable?
  inventoryItems InventoryItem[]
  rewards        Reward[]
}

model Consumable {
  id          String @id @default(uuid())
  itemId      String @unique
  effectType  String
  effectValue Int
  duration    Int?
  item        Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Inventory {
  id        String          @id @default(uuid())
  userId    String          @unique
  capacity  Int             @default(50)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     InventoryItem[]
}

model InventoryItem {
  id          String    @id @default(uuid())
  inventoryId String
  itemId      String
  quantity    Int       @default(1)
  isEquipped  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, itemId])
}

model MoneyJar {
  id             String   @id @default(uuid())
  userId         String   @unique
  coins          Int      @default(0)
  gems           Int      @default(0)
  vaultCoins     Int      @default(0)
  vaultHighest   Int      @default(0)
  realMoneySaved Float    @default(0)
  realMoneyGoal  Float    @default(10000)
  currency       String   @default("USD")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String          @id @default(uuid())
  userId    String
  amount    Float
  currency  String          @default("COIN")
  type      TransactionType
  source    String
  note      String?
  date      DateTime        @default(now())
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id                           String                @id @default(uuid())
  userId                       String
  name                         String
  balance                      Float                 @default(0.0)
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  personalTransferTransactions PersonalTransaction[] @relation("TransferTransactions")
  personalTransactions         PersonalTransaction[] @relation("WalletTransactions")
  user                         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model PersonalCategory {
  id                   String                @id @default(uuid())
  userId               String
  name                 String
  type                 String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  personalBudgets      PersonalBudget[]
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalTransactions PersonalTransaction[]

  @@unique([userId, name, type])
}

model PersonalTransaction {
  id         String            @id @default(uuid())
  userId     String
  amount     Float
  type       String
  categoryId String?
  note       String?
  date       DateTime          @default(now())
  walletId   String
  toWalletId String?
  createdAt  DateTime          @default(now())
  category   PersonalCategory? @relation(fields: [categoryId], references: [id])
  toWallet   Wallet?           @relation("TransferTransactions", fields: [toWalletId], references: [id])
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet     Wallet            @relation("WalletTransactions", fields: [walletId], references: [id], onDelete: Cascade)
}

model PersonalBudget {
  id         String           @id @default(uuid())
  userId     String
  amount     Float
  month      Int
  year       Int
  categoryId String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  category   PersonalCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
}

model Purchase {
  id        String   @id @default(uuid())
  userId    String
  itemId    String
  price     Int
  currency  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reward {
  id            String         @id @default(uuid())
  name          String
  description   String
  itemId        String?
  coinAmount    Int            @default(0)
  xpAmount      Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  item          Item?          @relation(fields: [itemId], references: [id])
  seasonRewards SeasonReward[]
}

model Pet {
  id         String    @id @default(uuid())
  userId     String
  name       String
  species    String
  level      Int       @default(1)
  xp         Int       @default(0)
  rarity     String    @default("Common")
  equipment  String?
  isEquipped Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stats      PetStats?
}

model PetStats {
  id         String   @id @default(uuid())
  petId      String   @unique
  hunger     Int      @default(100)
  loyalty    Int      @default(0)
  happiness  Int      @default(100)
  bonusType  String?
  bonusValue Int?
  updatedAt  DateTime @updatedAt
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String                @id @default(uuid())
  name        String
  description String
  isHidden    Boolean               @default(false)
  iconUrl     String?
  requirement Int                   @default(1)
  metric      String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  progress    AchievementProgress[]
}

model AchievementProgress {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  progress      Int         @default(0)
  isUnlocked    Boolean     @default(false)
  unlockedAt    DateTime?
  updatedAt     DateTime    @updatedAt
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Streak {
  id               String   @id @default(uuid())
  userId           String
  name             String
  description      String?
  icon             String   @default("🔥")
  color            String   @default("red")
  frequency        String   @default("Daily")
  reminder         String?
  xpReward         Int      @default(20)
  coinReward       Int      @default(5)
  current          Int      @default(0)
  best             Int      @default(0)
  lastCheckin      DateTime @default(now())
  totalCompletions Int      @default(0)
  isArchived       Boolean  @default(false)
  isPaused         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Schedule {
  id        String          @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  events    CalendarEvent[]
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id             String   @id @default(uuid())
  scheduleId     String
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  isRecurring    Boolean  @default(false)
  recurrenceRule String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  schedule       Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

model Season {
  id          String         @id @default(uuid())
  name        String
  description String
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  passes      SeasonPass[]
  rewards     SeasonReward[]
}

model SeasonPass {
  id        String   @id @default(uuid())
  userId    String
  seasonId  String
  isPremium Boolean  @default(false)
  level     Int      @default(1)
  xp        Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
}

model SeasonReward {
  id        String   @id @default(uuid())
  seasonId  String
  level     Int
  isPremium Boolean  @default(false)
  rewardId  String
  createdAt DateTime @default(now())
  reward    Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}

model AIInsight {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String?
  eventType String
  payload   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  dueDate     DateTime?
  dueTime     String?
  priority    String    @default("Medium")
  category    String    @default("General")
  repeat      String    @default("None")
  notes       String?
  completed   Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FocusSession {
  id          String   @id @default(uuid())
  userId      String
  taskId      String?
  taskTitle   String?
  duration    Int
  xpEarned    Int      @default(0)
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Chronicle {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  type      String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShopState {
  id            String   @id @default(uuid())
  userId        String   @unique
  lastRefreshed DateTime @default(now())
  itemIds       String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SkillMastery {
  id        String   @id @default(uuid())
  userId    String
  category  String
  xp        Int      @default(0)
  level     Int      @default(1)
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model WorldRegion {
  id         String    @id @default(uuid())
  userId     String
  regionId   String
  unlocked   Boolean   @default(false)
  unlockedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, regionId])
}

enum QuestType {
  DAILY
  WEEKLY
  HABIT
  STORY
  REPEATABLE
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum BattleStatus {
  IN_PROGRESS
  VICTORY
  DEFEAT
}

enum ItemType {
  EQUIPMENT
  CONSUMABLE
  MATERIAL
  COSMETIC
}

enum TransactionType {
  EARN
  SPEND
}
